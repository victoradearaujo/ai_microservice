<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jj_smart_alert_tree" model="ir.ui.view">
        <field name="name">jj.smart.alert.tree</field>
        <field name="model">jj.smart.alert</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="alert_message"/>
                <field name="priority"/>
                <field name="timestamp"/>
            </tree>
        </field>
    </record>

    <record id="view_jj_smart_alert_form" model="ir.ui.view">
        <field name="name">jj.smart.alert.form</field>
        <field name="model">jj.smart.alert</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alert_message"/>
                        <field name="priority"/>
                        <field name="state"/>
                        <field name="timestamp"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jj_smart_alerts" model="ir.actions.act_window">
        <field name="name">Smart Alerts</field>
        <field name="res_model">jj.smart.alert</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_jj_smart_alert_root" name="Smart Alerts" sequence="10"/>
    <menuitem id="menu_jj_smart_alerts" parent="menu_jj_smart_alert_root" name="Alerts" action="action_jj_smart_alerts"/>
</odoo>
