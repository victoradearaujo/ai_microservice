<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cron job: Smart Alerts from FastAPI every 2 hours -->
    <record id="ir_cron_fetch_smart_alerts" model="ir.cron">
        <field name="name">Fetch Smart Alerts</field>
        <field name="model_id" ref="model_jj_smart_alert"/>
        <field name="state">code</field>
        <field name="code">model.fetch_from_api()</field>
        <field name="active" eval="True"/>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="numbercall" eval="-1"/>
        <field name="doall" eval="False"/>
    </record>
</odoo>
